{
  "realm": "jyxia-dev",
  "enabled": true,
  "displayName": "JYXIA Local Development Realm (Synthetic Only)",
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "verifyEmail": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "browserFlow": "jyxia-mfa-browser",
  "attributes": {
    "acr.loa.map": "{\"urn:jyxia:loa:mfa\": 2}"
  },
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyInitialCounter": 0,
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "otpPolicyLookAheadWindow": 1,
  "clientScopes": [
    {
      "name": "acr",
      "description": "OpenID Connect ACR and AMR assurance claims scope",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "acr-loa-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-acr-mapper",
          "consentRequired": false,
          "config": {
            "id.token.claim": "true",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "amr-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-amr-mapper",
          "consentRequired": false,
          "config": {
            "id.token.claim": "true",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "defaultDefaultClientScopes": [
    "web-origins",
    "acr",
    "profile",
    "roles",
    "email"
  ],
  "clients": [
    {
      "clientId": "jyxia-backend-dev",
      "name": "JYXIA Backend Dev Confidential BFF Client",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "SYNTHETIC_DEV_KEYCLOAK_SECRET_CHANGE_ME",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": false,
      "redirectUris": [
        "http://127.0.0.1:8000/api/v1/auth/callback",
        "http://localhost:8000/api/v1/auth/callback"
      ],
      "webOrigins": [
        "http://127.0.0.1:8000",
        "http://localhost:8000"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://127.0.0.1:8000/*##http://localhost:8000/*",
        "acr.loa.map": "{\"urn:jyxia:loa:mfa\": 2}",
        "default.acr.values": "urn:jyxia:loa:mfa",
        "minimum.acr.value": "urn:jyxia:loa:mfa"
      },
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "roles",
        "email"
      ],
      "protocolMappers": [
        {
          "name": "jyxia-acr-id-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-acr-mapper",
          "consentRequired": false,
          "config": {
            "id.token.claim": "true",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "jyxia-amr-id-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-amr-mapper",
          "consentRequired": false,
          "config": {
            "id.token.claim": "true",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "authenticationFlows": [
    {
      "alias": "jyxia-mfa-browser",
      "description": "Mandatory password + TOTP MFA browser flow for JYXIA development",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-cookie",
          "authenticatorFlow": false,
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "authenticatorFlow": true,
          "flowAlias": "jyxia-mfa-forms",
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "jyxia-mfa-forms",
      "description": "Username/Password plus LoA 2 OTP subflow",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-username-password-form",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "authenticatorFlow": true,
          "flowAlias": "jyxia-loa2-otp-subflow",
          "requirement": "CONDITIONAL",
          "priority": 20,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "jyxia-loa2-otp-subflow",
      "description": "Require TOTP second factor for LoA 2 / urn:jyxia:loa:mfa",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "conditional-level-of-authentication",
          "authenticatorConfig": "jyxia-loa2-condition-config",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "authenticator": "auth-otp-form",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false
        }
      ]
    }
  ],
  "authenticatorConfig": [
    {
      "alias": "jyxia-loa2-condition-config",
      "config": {
        "loa-condition-level": "2",
        "loa-max-age": "36000"
      }
    }
  ],
  "users": []
}
