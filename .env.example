# Exemplo de configuracao local para a fundacao institucional JYXIA (Etapa 3.0).
# NUNCA publique arquivos .env reais e NUNCA utilize dados ou identificadores de pacientes reais.

JYXIA_APP_NAME=JYXIA Institutional Foundation
JYXIA_ENV=development
JYXIA_LOG_LEVEL=INFO

# Banco relacional PostgreSQL local (Compose ou instancia controlada local)
JYXIA_DATABASE_URL=postgresql+psycopg://jyxia:SYNTHETIC_LOCAL_ONLY_CHANGE_ME@127.0.0.1:5432/jyxia_institutional

# Armazenamento controlado sintetico fora do repositorio Git
JYXIA_STORAGE_ROOT=../JYXIA_LOCAL_WORK/synthetic_storage
JYXIA_ALLOW_LOCAL_SYNTHETIC_STORAGE=true
JYXIA_MAX_DOCUMENT_BYTES=10485760

# Credenciais locais apenas para compose.institutional.yaml (substituir localmente antes de subir)
POSTGRES_USER=jyxia
POSTGRES_PASSWORD=SYNTHETIC_LOCAL_ONLY_CHANGE_ME
POSTGRES_DB=jyxia_institutional

# Preparacao OIDC/MFA (nao ativa nesta fase 0.1.0; nao habilite sem provedor OIDC verificado)
JYXIA_OIDC_ENABLED=false
JYXIA_OIDC_ISSUER=
JYXIA_OIDC_CLIENT_ID=
