# Exemplo de configuracao local para a fundacao institucional JYXIA (Etapa 3.2).
# ATENCAO: Substitua todos os marcadores SYNTHETIC_* antes de subir servicos reais.
# NUNCA publique arquivos .env reais e NUNCA utilize dados ou identificadores de pacientes reais.

JYXIA_APP_NAME=JYXIA Institutional Foundation
JYXIA_ENV=development
JYXIA_DEBUG=false
JYXIA_LOG_LEVEL=INFO
JYXIA_APP_BASE_URL=http://127.0.0.1:8000

# Separacao de papeis PostgreSQL: runtime API (jyxia_app), worker (jyxia_worker) e owner de migracoes (jyxia_migrator)
JYXIA_DATABASE_URL=postgresql+psycopg://jyxia_app:SYNTHETIC_APP_ROLE_LOCAL_CHANGE_ME@127.0.0.1:5432/jyxia_institutional
JYXIA_WORKER_DATABASE_URL=postgresql+psycopg://jyxia_worker:SYNTHETIC_WORKER_ROLE_LOCAL_CHANGE_ME@127.0.0.1:5432/jyxia_institutional
JYXIA_MIGRATION_DATABASE_URL=postgresql+psycopg://jyxia_migrator:SYNTHETIC_LOCAL_ONLY_CHANGE_ME@127.0.0.1:5432/jyxia_institutional

# Parametros iniciais do container PostgreSQL e Keycloak local (compose.institutional.yaml)
POSTGRES_USER=jyxia_migrator
POSTGRES_PASSWORD=SYNTHETIC_LOCAL_ONLY_CHANGE_ME
POSTGRES_DB=jyxia_institutional
JYXIA_APP_DB_PASSWORD=SYNTHETIC_APP_ROLE_LOCAL_CHANGE_ME
JYXIA_WORKER_DB_PASSWORD=SYNTHETIC_WORKER_ROLE_LOCAL_CHANGE_ME
KC_BOOTSTRAP_ADMIN_USERNAME=jyxia_dev_admin
KC_BOOTSTRAP_ADMIN_PASSWORD=SYNTHETIC_KC_ADMIN_CHANGE_ME

# Worker assincrono duravel (Etapa 3.3.2 / 3.3.3 - integridade e extracao textual PDF)
JYXIA_WORKER_ENABLED=true
JYXIA_WORKER_ID=jyxia-worker-1
JYXIA_WORKER_POLL_INTERVAL_SECONDS=1.0
JYXIA_WORKER_LEASE_SECONDS=60
JYXIA_WORKER_MAX_ATTEMPTS=5
JYXIA_WORKER_RETRY_BACKOFF_MIN_SECONDS=2.0
JYXIA_WORKER_RETRY_BACKOFF_MAX_SECONDS=60.0
JYXIA_WORKER_RETRY_JITTER_RATIO=0.2
JYXIA_WORKER_MAX_JOBS_PER_CYCLE=10
JYXIA_PDF_MAX_PAGES=50
JYXIA_PDF_MAX_EXTRACTED_CHARS=250000
JYXIA_PDF_MAX_WORDS_PER_DOC=50000
JYXIA_PDF_MAX_BLOCKS_PER_PAGE=1000
JYXIA_PDF_EXTRACTION_TIMEOUT_SECONDS=10.0
JYXIA_PDF_MAX_COMPLEXITY_OBJECTS=20000

# Armazenamento controlado sintetico fora do repositorio Git
JYXIA_STORAGE_ROOT=../JYXIA_LOCAL_WORK/synthetic_storage
JYXIA_ALLOW_LOCAL_SYNTHETIC_STORAGE=true
JYXIA_MAX_DOCUMENT_BYTES=10485760

# Autenticacao OIDC PKCE S256 + MFA obrigatorio (em producao exige HTTPS estrito e OIDC_ALLOW_HTTP_DEV=false)
JYXIA_OIDC_ENABLED=true
JYXIA_OIDC_ALLOW_HTTP_DEV=true
JYXIA_OIDC_ISSUER=http://127.0.0.1:8080/realms/jyxia-dev
JYXIA_OIDC_CLIENT_ID=jyxia-backend-dev
JYXIA_OIDC_CLIENT_SECRET=SYNTHETIC_DEV_KEYCLOAK_SECRET_CHANGE_ME
JYXIA_OIDC_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/callback
JYXIA_OIDC_POST_LOGOUT_REDIRECT_URI=http://127.0.0.1:8000/
JYXIA_OIDC_AUDIENCE=
JYXIA_OIDC_MFA_REQUIRED=true
JYXIA_OIDC_REQUIRE_BOTH_ACR_AND_AMR=true
JYXIA_OIDC_ALLOWED_ACR=urn:jyxia:loa:mfa
JYXIA_OIDC_ALLOWED_AMR=otp,totp,hwk,fido,webauthn,mfa
JYXIA_OIDC_MAX_AUTH_AGE_SECONDS=3600
JYXIA_OIDC_ALLOWED_ALGORITHMS=RS256,ES256
JYXIA_OIDC_CLOCK_SKEW_SECONDS=60
JYXIA_OIDC_JWKS_CACHE_TTL_SECONDS=300
JYXIA_OIDC_JWKS_REFRESH_COOLDOWN_SECONDS=15
JYXIA_OIDC_HTTP_TIMEOUT_SECONDS=5.0

# Sessao server-side, CSRF e CORS (em producao Cookie Secure=true e origens HTTPS explicitas)
JYXIA_SESSION_SECRET=SYNTHETIC_DEV_SESSION_SECRET_32_CHARS_MIN_CHANGE_ME
JYXIA_CSRF_SECRET=SYNTHETIC_DEV_CSRF_SECRET_32_CHARS_MIN_CHANGE_ME
JYXIA_SESSION_COOKIE_SECURE=false
JYXIA_SESSION_IDLE_TIMEOUT_SECONDS=1800
JYXIA_SESSION_ABSOLUTE_TIMEOUT_SECONDS=28800
JYXIA_CORS_ALLOWED_ORIGINS=http://127.0.0.1:8000
