FROM python:3.13-slim@sha256:e48f59cdba69a3cbd9ed2cf0f348d90d45a8d350d98134cf1070bc106ee9ed90
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY serve_documental.py index.html demo.html documental.css documental-core.mjs documental-ui.mjs documental-manifest.json ./
COPY fixtures/ ./fixtures/
COPY vendor/ ./vendor/
COPY fixtures-jyxia.zip Projeto_JYXIA_Inteligencia_Documental_v3.docx ./
RUN useradd --create-home --uid 10001 app
USER 10001
EXPOSE 8000
CMD ["python", "serve_documental.py", "--bind", "0.0.0.0"]
